# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Python bytecode + caches
__pycache__/
*.py[cod]
*$py.class
*.so
*.dylib
*.pyd

# Build / packaging artefacts (pip / setuptools / build / wheel)
*.egg-info/
*.dist-info/
*.egg
.eggs/
dist/
build/
sdist/
wheels/
pip-wheel-metadata/
share/python-wheels/

# pip / venv temp folders that crop up during install
pip-*-build/
pip-tmp/
.installed.cfg

# IDE
.vscode/
.idea/
*.swp
*.swo

# Test / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml

# OS-specific cruft (Mac and Windows)
.DS_Store
.AppleDouble
.LSOverride
__MACOSX/
._*
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk

# Session debris — anything starting with `_` plus an extension. The two
# tracked utility scripts (`_headless_launch.py`, `_launch_nosync.py`) are
# already in the repo so this glob doesn't kick them out, but it does keep
# ad-hoc `_tray_*.png`, `_daemon.log`, etc. from being committed.
_*.png
_*.bin
_*.log
_*.log.*
_*.tmp
_iconsnap*
_tray_*.py

# WhisperApp runtime
*.db
.whisperapp_partials/
*.log
*.err
*.tmp
*.tmp.*
worker.py.tmp.*

# Claude Code machine-local settings and superpowers plugin files
.claude/settings.local.json
.claude/launch.json
docs/superpowers/

# Design reference files (Dropbox-synced separately)
Design/

# Cross-machine coordination file — synced via Dropbox between Mac and Windows.
# May contain secrets (API keys etc.) that must NEVER reach GitHub.
COMMS.md

# whisper_webui outputs and downloaded models
whisper_webui/outputs/
whisper_webui/models/

# ML model weights
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.gguf
*.mlpackage

# Build artefacts — rebuilt per platform, never committed
dist/
build/
*.spec.log
*.dSYM/

# Installer output
installer/WhisperApp*.exe
installer/WhisperApp*.dmg

# Test audio fixtures (generated)
tests/fixtures/*.wav
