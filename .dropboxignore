# Dropbox ignore rules for the WhisperApp dev tree.
#
# The whole repo lives in Dropbox so it syncs between Mac and Windows. Anything
# that's machine-local — virtual envs, compiled extensions, build artefacts,
# OS cruft — must not sync, otherwise we end up shipping Windows .pyd files to
# the Mac and Mach-O .dylib/.so files back the other way.
#
# Format is git-style globs (Dropbox honours these on the .dropboxignore that
# sits in the synced folder). Patterns ending in `/` match directories.

# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Python bytecode + native extensions (platform-specific) ─────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.dylib
*.pyd

# ── pip / setuptools / build / wheel artefacts ──────────────────────────────
*.egg-info/
*.dist-info/
*.egg
.eggs/
dist/
build/
sdist/
wheels/
pip-wheel-metadata/
pip-*-build/
pip-tmp/
.installed.cfg
share/python-wheels/

# ── Test / lint caches (frequently regenerated, machine-local) ──────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# ── ML model weights — machine-local downloads, can be huge ─────────────────
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.gguf
*.mlpackage

# ── OS cruft — both platforms ───────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
__MACOSX/
._*
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk

# ── IDE state ───────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── WhisperApp runtime artefacts ────────────────────────────────────────────
*.db
.whisperapp_partials/
*.log
*.err
*.tmp
*.tmp.*
worker.py.tmp.*

# ── Build / installer outputs ───────────────────────────────────────────────
installer/WhisperApp*.exe
installer/WhisperApp*.dmg
*.spec.log
*.dSYM/

# ── Session debris (ad-hoc scripts / screenshots created during dev) ────────
_*.png
_*.bin
_*.log
_*.log.*
_*.tmp
_iconsnap*
_tray_*.py

# ── Generated test fixtures ─────────────────────────────────────────────────
tests/fixtures/*.wav

# ── whisper_webui sub-tree outputs ──────────────────────────────────────────
whisper_webui/outputs/
whisper_webui/models/
